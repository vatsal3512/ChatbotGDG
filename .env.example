# ── LLM Provider ──────────────────────────────────────────────────────────────
# Which provider to use: "groq" (default) or "gemini"
LLM_PROVIDER=groq

# Groq free-tier API key — https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Gemini free-tier API key — https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# ── Models (optional overrides) ───────────────────────────────────────────────
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.0-flash

# ── Paths (optional overrides) ────────────────────────────────────────────────
DB_PATH=data/cf_problems.db
CHROMA_PATH=retrieval/chroma_db
BM25_INDEX_PATH=retrieval/bm25_index.pkl

# ── Agent Settings ────────────────────────────────────────────────────────────
MAX_TOOL_TURNS=6
LOG_PATH=logs/agent.log
